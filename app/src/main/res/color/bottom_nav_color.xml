<?xml version="1.0" encoding="utf-8"?>
<!--
    Selector for Bottom Navigation
    Defines different colors for selected and unselected states.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Color when an item is selected -->
    <item android:color="@color/coffee_primary" android:state_checked="true" />
    <!-- Default color for unselected items -->
    <item android:color="@color/grey_dark" />
</selector>